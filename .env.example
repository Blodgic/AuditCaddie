# ─────────────────────────────────────────────────────────────────────────────
#  AuditCaddie OSS — Environment Configuration
#  Docs: https://github.com/Blodgic/AuditCaddie
# ─────────────────────────────────────────────────────────────────────────────
#
#  You do NOT need to fill this out manually.
#  The installer creates a minimal .env and the dashboard setup wizard
#  collects your credentials on first launch — stored in the local database.
#
#  Use this file only if you prefer to configure via environment variables
#  (e.g. for Docker secrets, CI, or scripted deployments).
#  Environment variables here take precedence over dashboard-saved values.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider (optional — configure in dashboard if not set here) ───────────
# Get OpenAI key at:    https://platform.openai.com/api-keys
# Get Anthropic key at: https://console.anthropic.com/settings/keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=gpt-4o   # or claude-sonnet-4-6

# ── AWS (optional — required for AWS scanning) ────────────────────────────────
# Uses read-only access (SecurityAudit managed policy recommended).
# Leave blank to use IAM roles, instance profiles, or AWS CLI credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# ── GitHub (optional — required for GitHub scanning) ──────────────────────────
# Create a token at: https://github.com/settings/tokens/new
# Required scopes: repo, read:org
# GITHUB_TOKEN=
# GITHUB_ORG=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Optional: protect instance with a password ────────────────────────────────
# If set, a password prompt is shown before accessing the UI
# AUDITCADDIE_PASSWORD=
